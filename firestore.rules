
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // --- USER DATA RULES (STRICTLY PRIVATE) ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.subscriptionTier == 'SENTINEL';
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'whatsapp', 'age', 'address',
          'preferredDisplayMode', 'updatedAt', 'id'
        ])
        && request.resource.data.id == userId);
      
      match /consents/{consentId} {
        allow get, list, create, update: if isOwner(userId);
      }
      
      match /assets/{assetId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // --- GLOBAL DATA RULES (PUBLIC READ FOR LANDING PAGE & DASHBOARD STABILITY) ---

    match /global_intelligence_alerts/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /autonomous_insights/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /whale_transactions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /market_entities/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /market_prices/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- ADMIN RULES ---

    match /admin_roles/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list: if isAdmin();
    }
  }
}
