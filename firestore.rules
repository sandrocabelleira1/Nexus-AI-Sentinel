
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/assets/{assetId} {
      allow read, write: if isOwner(userId);
    }

    match /global_intelligence_alerts/{alertId} {
      allow read, write: if isSignedIn();
    }

    match /autonomous_insights/{insightId} {
      allow read, write: if isSignedIn();
    }

    match /market_prices/{ticker} {
      allow read, write: if isSignedIn();
    }

    match /whale_transactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /market_entities/{entityId} {
      allow read, write: if isSignedIn();
    }
    
    match /global_intelligence_alerts {
       allow list: if isSignedIn();
    }
    
    match /market_prices {
       allow list: if isSignedIn();
    }

    match /autonomous_insights {
       allow list: if isSignedIn();
    }

    match /whale_transactions {
       allow list: if isSignedIn();
    }

    match /market_entities {
       allow list: if isSignedIn();
    }
  }
}
