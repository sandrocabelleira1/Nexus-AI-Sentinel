/**
 * Nexus AI Sentinel - Firestore Security Rules v2.3
 * Otimizado para suporte a varredura global e proteção de dados de usuário.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    // --- USER DATA RULES ---

    match /users/{userId} {
      // Admins podem visualizar todos os perfis para relatórios
      allow get, list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      
      match /consents/{consentId} {
        allow get, list, create, update: if isOwner(userId);
      }
      
      match /assets/{assetId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      
      match /alerts/{alertId} {
        allow get, list, create: if isOwner(userId);
      }

      match /chatSessions/{sessionId} {
        allow get, list, create, update, delete: if isOwner(userId);
        
        match /messages/{messageId} {
          allow get, list, create: if isOwner(userId);
        }
      }
    }

    // --- GLOBAL DATA RULES (Client-Side Intelligence Persistence) ---

    match /global_intelligence_alerts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /autonomous_insights/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /whale_transactions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /market_entities/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /market_prices/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- ADMIN RULES ---

    match /admin_roles/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
    }
  }
}