
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile and general application settings within the Nexus AI Sentinel app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's preferred name for display."
        },
        "whatsapp": {
          "type": "string",
          "description": "O número de WhatsApp do usuário para alertas críticos."
        },
        "age": {
          "type": "number",
          "description": "A idade do usuário."
        },
        "address": {
          "type": "string",
          "description": "O endereço residencial ou comercial do usuário."
        },
        "preferredDisplayMode": {
          "type": "string",
          "description": "Simplified or Technical data mode."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "whatsapp",
        "age",
        "address",
        "preferredDisplayMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserConsent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserConsent",
      "type": "object",
      "description": "Records a user's agreement to specific terms.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the UserProfile."
        },
        "consentType": {
          "type": "string"
        },
        "consentVersion": {
          "type": "string"
        },
        "agreedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "consentType",
        "consentVersion",
        "agreedAt"
      ]
    },
    "AdminRole": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminRole",
      "type": "object",
      "description": "Represents an administrative role assignment.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "MODERATOR"]
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["role", "assignedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Core profile information."
        }
      },
      {
        "path": "/users/{userId}/consents/{consentId}",
        "definition": {
          "entityName": "UserConsent",
          "schema": {
            "$ref": "#/backend/entities/UserConsent"
          }
        }
      },
      {
        "path": "/admin_roles/{adminUid}",
        "definition": {
          "entityName": "AdminRole",
          "schema": {
            "$ref": "#/backend/entities/AdminRole"
          },
          "description": "Identifies global administrators."
        }
      }
    ]
  }
}
