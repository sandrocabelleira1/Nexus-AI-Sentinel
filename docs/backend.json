
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile and preferences within the Nexus AI application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity. This typically corresponds to the Firebase Authentication User ID."
        },
        "email": {
          "type": "string",
          "description": "The user's primary email address.",
          "format": "email"
        },
        "preferredDisplayMode": {
          "type": "string",
          "description": "The user's preferred mode for displaying financial explanations and data. 'Essential' provides simplified explanations, 'Full' provides technical data.",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "preferredDisplayMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Represents a financial asset manually registered by a user, including its type, quantity, and storage location.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Asset entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the UserProfile entity that owns this asset. (Relationship: UserProfile 1:N Asset)"
        },
        "name": {
          "type": "string",
          "description": "The human-readable name of the asset (e.g., 'Vale', 'Bitcoin')."
        },
        "tickerSymbol": {
          "type": "string",
          "description": "The ticker symbol or short code for the asset (e.g., 'VALE3', 'BTC')."
        },
        "assetType": {
          "type": "string",
          "description": "The category or type of the financial asset (e.g., 'Stock', 'Cryptocurrency', 'Real Estate Fund', 'Bond')."
        },
        "quantity": {
          "type": "number",
          "description": "The quantity or number of units of the asset owned by the user."
        },
        "averagePurchasePrice": {
          "type": "number",
          "description": "The average price at which the asset was purchased per unit."
        },
        "storageLocation": {
          "type": "string",
          "description": "The platform or location where the asset is held (e.g., 'Binance', 'Ledger', 'XP Investimentos')."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the asset record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the asset record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "tickerSymbol",
        "assetType",
        "quantity",
        "storageLocation",
        "createdAt",
        "updatedAt"
      ]
    },
    "GlobalIntelligenceAlert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GlobalIntelligenceAlert",
      "type": "object",
      "description": "Stores a predictive financial alert generated by the Nexus AI.",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "title": { "type": "string" },
        "eventOrigin": { "type": "string" },
        "causalityExplanation": { "type": "string" },
        "priority": { "type": "number" },
        "marketAction": { "type": "string" },
        "riskLevel": { "type": "string" },
        "affectedAssetTickerSymbols": { "type": "array", "items": { "type": "string" } },
        "essentialText": { "type": "string" },
        "affectedAssetsDetails": { "type": "array", "items": { "$ref": "#/backend/entities/AffectedAssetDetail" } }
      }
    },
    "AffectedAssetDetail": {
      "type": "object",
      "properties": {
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "recommendation": { "type": "string" },
        "impactType": { "type": "string" },
        "expectedGainPercentage": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "AutonomousInsight": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AutonomousInsight",
      "type": "object",
      "description": "Stores a rumor or speculation detected autonomously by Nexus AI.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "topic": { "type": "string" },
        "foundation_score": { "type": "number" },
        "source_credibility": { "type": "string" },
        "market_impact": { "type": "string" },
        "nexus_priority": { "type": "number" },
        "scenarios": {
          "type": "object",
          "properties": {
            "optimistic": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } },
            "baseline": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } },
            "risk": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } }
          }
        }
      }
    },
    "MarketPrice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketPrice",
      "type": "object",
      "description": "Real-time market price for a specific ticker symbol.",
      "properties": {
        "ticker": { "type": "string" },
        "price": { "type": "number" },
        "change24h": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticker", "price", "updatedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores individual user profiles."
        }
      },
      {
        "path": "/users/{userId}/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "schema": { "$ref": "#/backend/entities/Asset" },
          "description": "Stores user-registered financial assets."
        }
      },
      {
        "path": "/global_intelligence_alerts/{alertId}",
        "definition": {
          "entityName": "GlobalIntelligenceAlert",
          "schema": { "$ref": "#/backend/entities/GlobalIntelligenceAlert" },
          "description": "AI-generated predictive financial alerts."
        }
      },
      {
        "path": "/autonomous_insights/{insightId}",
        "definition": {
          "entityName": "AutonomousInsight",
          "schema": { "$ref": "#/backend/entities/AutonomousInsight" },
          "description": "Rumors and whispers detected autonomously."
        }
      },
      {
        "path": "/market_prices/{ticker}",
        "definition": {
          "entityName": "MarketPrice",
          "schema": { "$ref": "#/backend/entities/MarketPrice" },
          "description": "Real-time market data feed."
        }
      }
    ]
  }
}
