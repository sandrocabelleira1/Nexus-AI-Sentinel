
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile and preferences within the Nexus AI application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "preferredDisplayMode": { "type": "string", "enum": ["Essencial", "Completo"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "preferredDisplayMode", "createdAt", "updatedAt"]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Represents a financial asset manually registered by a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "tickerSymbol": { "type": "string" },
        "assetType": { "type": "string" },
        "quantity": { "type": "number" },
        "investedValue": { "type": "number" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "tickerSymbol", "assetType", "quantity", "location"]
    },
    "WhaleTransaction": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blockchain": { "type": "string" },
        "symbol": { "type": "string" },
        "amount": { "type": "number" },
        "amountUsd": { "type": "number" },
        "fromAddress": { "type": "string" },
        "toAddress": { "type": "string" },
        "transactionType": { "type": "string", "enum": ["exchange_deposit", "exchange_withdrawal", "wallet_transfer"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "MarketEntity": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Government", "Institution", "Exchange", "Whale"] },
        "influenceScore": { "type": "number" },
        "lastAction": { "type": "string" },
        "currentBalanceUsd": { "type": "number" }
      }
    },
    "GlobalIntelligenceAlert": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "eventOrigin": { "type": "string" },
        "causalityExplanation": { "type": "string" },
        "priority": { "type": "number" },
        "marketAction": { "type": "string" },
        "essentialText": { "type": "string" },
        "affectedAssetTickerSymbols": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AutonomousInsight": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "foundation_score": { "type": "number" },
        "market_impact": { "type": "string" },
        "scenarios": {
          "type": "object",
          "properties": {
            "optimistic": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } },
            "baseline": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } },
            "risk": { "type": "object", "properties": { "desc": { "type": "string" }, "prob": { "type": "string" } } }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "description": "User assets."
        }
      },
      {
        "path": "/whale_transactions/{txId}",
        "definition": {
          "entityName": "WhaleTransaction",
          "description": "Large blockchain transactions."
        }
      },
      {
        "path": "/market_entities/{entityId}",
        "definition": {
          "entityName": "MarketEntity",
          "description": "Institutional actors and governments."
        }
      },
      {
        "path": "/global_intelligence_alerts/{alertId}",
        "definition": {
          "entityName": "GlobalIntelligenceAlert",
          "description": "Predictive alerts."
        }
      },
      {
        "path": "/autonomous_insights/{insightId}",
        "definition": {
          "entityName": "AutonomousInsight",
          "description": "AI-detected whispers."
        }
      }
    ]
  }
}
